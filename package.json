{
  "name": "pardigon",
  "version": "1.0.0",
  "description": "Lightweight procedural cinematic grain for the web.",
  "license": "MIT",
  "author": "Quentin Ecrepont",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quentinecrepont/Pardigon.git"
  },
  "homepage": "https://github.com/quentinecrepont/Pardigon#readme",
  "bugs": {
    "url": "https://github.com/quentinecrepont/Pardigon/issues"
  },
  "keywords": [
    "film-grain",
    "webgl2",
    "glsl",
    "procedural-noise",
    "creative-coding"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "npm run typecheck && vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && tsc -p tsconfig.test.json && tsc -p tsconfig.unit.json && node --test",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
